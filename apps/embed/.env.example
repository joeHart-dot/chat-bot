# Copia este archivo a .env.local y rellénalo. Lo leen la app Next y el build del loader.

# URL base del backend (sin barra final). Se incrusta en el loader al compilarlo como valor por
# defecto (un cliente puede sobrescribirlo con data-api-base) y limita connect-src de la CSP a ese
# origen. Si se deja vacía, el loader exige data-api-base y connect-src admite cualquier https.
WIDGET_API_BASE=

# Quién puede embeber el chat en un iframe (frame-ancestors). "*" permite cualquier web; la
# restricción real por origen la aplica el backend con la clave pública. Ej.: https://cliente.com
WIDGET_FRAME_ANCESTORS=*

# Página /demo con el widget instalado, para probar. Déjala en false en producción.
ENABLE_DEMO=false
# Clave pública pk_... registrada para el origen donde se sirve /demo.
DEMO_WIDGET_KEY=
